# Copy to backend/.env and adjust as needed. We can use the file to store private keys, database connection strings, credentials and other sensitive information. The .env is gitignored and therefore will not be publically available on repo.
# CORS_ORIGINS=["http://localhost:5173"]

# NCBI E-utilities (PubMed). Optional, but a key raises the limit from 3 to 10 requests/second.
# Get one at https://account.ncbi.nlm.nih.gov/settings/ under "API Key Management".
# NCBI_API_KEY=
# NCBI_EMAIL=

# Crossref (retraction and correction notices). Optional, but an email doubles the rate limit.
# CROSSREF_MAILTO=

# Azure model inference (Foundry). The deployment must support Chat Completions
# with structured outputs.
# Resource base URL or its /openai/v1 URL; not a project URL (/api/projects/...).
AZURE_INFERENCE_ENDPOINT=
# Exact deployment name assigned in Azure, which may differ from the model name.
AZURE_MODEL_DEPLOYMENT_NAME=
# API key for the resource serving that deployment.
AZURE_INFERENCE_API_KEY=

# PostgreSQL connection for saved example results.
# DATABASE_URL=postgresql://secondopinion:password@localhost:5432/secondopinion

# In-memory cache for POST /api/claims. Defaults: 6 hours, 256 entries. TTL 0 turns it off.
# CLAIMS_CACHE_TTL_SECONDS=21600
# CLAIMS_CACHE_MAX_ENTRIES=256

# Optional persistent claim cache. Use a distinct database name from DATABASE_URL.
# Without this setting, the existing in-memory cache is used.
# CACHE_DATABASE_URL=postgresql://secondopinion_cache:password@localhost:5432/secondopinion_cache

# Azure-producing workflow admissions, per client IP and server process.
# Claims and standalone normalization share the first budget. Cached normalization,
# completed overviews, and joining an in-flight overview do not consume tokens.
# Rates refill continuously; burst is the initial/maximum token capacity.
# Failed provider attempts count. A new overview reserves one token for its whole
# workflow (up to 20 readings plus synthesis), not one token per model call.
# AZURE_RATE_LIMIT_ENABLED=true
# AZURE_NORMALIZATION_PER_MINUTE=6
# AZURE_NORMALIZATION_BURST=6
# AZURE_OVERVIEW_PER_MINUTE=2
# AZURE_OVERVIEW_BURST=2
# Maximum retained IP identities per budget. Active entries are never evicted to
# reset their allowance. Unknown clients can get 429 while the table is full.
# AZURE_RATE_LIMIT_MAX_CLIENTS=10000
# Only disable for isolated tests/development, not a public deployment.
# AZURE_RATE_LIMIT_ENABLED=false
